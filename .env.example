# FixMate Environment Configuration
# Copy this file to .env and provide your actual Supabase project credentials.

# Supabase Project URL & Anon Key (from your Supabase Dashboard -> Project Settings -> API)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional: Push notification configuration
EXPO_PUBLIC_ENABLE_PUSH_NOTIFICATIONS=false

# App Environment
EXPO_PUBLIC_APP_ENV=development
